const $=s=>document.querySelector(s);let EX={},REG=[],state={screen:'landing',region:null,path:null,ex:null,step:0,reps:0,playing:true,pro:false};
const motionCue={chin:'Deslizá el mentón hacia atrás sin inclinar la cabeza',neckrotate:'Rotá la cabeza lentamente dentro de un rango cómodo',neckflex:'Flexioná y extendé el cuello con control',neckside:'Incliná la cabeza alejándola del hombro fijo',isometric:'Generá tensión sin permitir que el cuello se mueva',shoulder:'Realizá un círculo amplio y lento con ambos hombros',bridge:'Elevá la pelvis formando una línea entre hombros y rodillas',pelvic:'Aplaná suavemente la zona lumbar contra la colchoneta',kneechest:'Acercá la rodilla al pecho manteniendo la pelvis estable',catcow:'Alterná flexión y extensión de toda la columna',lumbarrotate:'Dejá caer las rodillas juntas hacia el costado',birddog:'Extendé brazo y pierna opuestos sin rotar la pelvis',deadbug:'Bajá brazo y pierna contrarios sin despegar la zona lumbar',plank:'Mantené el cuerpo alineado y el abdomen activo',squat:'Llevá la cadera atrás y abajo con las rodillas alineadas',march:'Elevá una rodilla manteniendo el tronco estable',nerve:'Deslizá el nervio sin sostener tensión al final',piriformis:'Acercá la pierna cruzada hacia el pecho',hamstring:'Extendé la rodilla hasta una tensión suave',hipflexor:'Llevá la pelvis hacia delante sin arquear la espalda',pressup:'Extendé el tronco manteniendo la pelvis apoyada',breathing:'Expandí abdomen y costillas al inhalar',supine:'Ejecutá el movimiento acostado con control',prone:'Ejecutá el movimiento boca abajo con control',quadruped:'Mantené la columna estable en cuatro apoyos',seated:'Conservá una postura erguida durante el movimiento',standing:'Ejecutá el movimiento de pie con control',balance:'Mantené el equilibrio con un apoyo cercano',walk:'Caminá con pasos cómodos y ritmo regular'};
function shell(content,active='Inicio'){return `<div class="app"><aside class="sidebar"><div><div class="brand">SPINEFLOW</div><div class="brandline">Rehabilitación de columna</div></div><nav class="nav">${['Inicio','Mi plan','Ejercicios','Progreso','Educación','Ajustes'].map(x=>`<button class="${active===x?'active':''}" onclick="goHome()">${x}</button>`).join('')}</nav><div class="coach"><div class="coachface"></div><b>MI PROFE</b><small>Tu guía clínica de movimiento</small></div></aside><main class="content">${content}</main></div>`}
function goHome(){state={...state,screen:'landing',region:null,path:null,ex:null};render()}
function landing(){return shell(`<section class="hero"><div><div class="eyebrow">SpineFlow V8 Professional</div><h1>Recuperación guiada para columna cervical, dorsal y lumbar.</h1><p>Programas organizados por región y patología, con demostración en cinco fases, músculos activados, voz clínica y seguimiento del progreso.</p><button class="btn primary" onclick="document.querySelector('.modules').scrollIntoView({behavior:'smooth'})">Explorar programas</button></div><div class="herovisual"><div class="orb a"></div><div class="orb b"></div><div class="spine"></div></div></section><div class="topbar" style="margin-top:30px"><div><div class="eyebrow">Elegí la región</div><h2 class="title">Tres módulos clínicos</h2></div><span class="pill">2 ejercicios gratis por patología</span></div><div class="modules">${REG.map(r=>`<article class="module" onclick="openRegion('${r.id}')"><div class="moduleicon" style="background:${r.color}">⌁</div><h3>${r.label}</h3><div class="meta">${r.subtitle}</div><p>${r.pathologies.length} patologías · ${r.pathologies.reduce((a,p)=>a+p.ex.length,0)} ejercicios</p></article>`).join('')}</div>`)}
function openRegion(id){state.region=REG.find(r=>r.id===id);state.screen='region';render()}
function regionView(){let r=state.region;return shell(`<div class="topbar"><div><button class="btn secondary back" onclick="goHome()">← Volver</button><div class="eyebrow" style="margin-top:18px">Módulo ${r.label}</div><h1 class="title">Seleccioná una patología</h1></div><span class="pill">${r.pathologies.length} programas</span></div><div class="grid">${r.pathologies.map(p=>`<article class="pathcard" onclick="openPath('${p.id}')"><div class="pathhead"><div class="pathdot" style="background:${r.color}">${p.ex.length}</div><div><h3>${p.title}</h3><div class="meta">${p.desc}</div></div></div><p class="meta">2 gratuitos · ${Math.max(0,p.ex.length-2)} Premium</p></article>`).join('')}</div>`, 'Ejercicios')}
function openPath(id){state.path=state.region.pathologies.find(p=>p.id===id);state.screen='path';render()}
function pathView(){let p=state.path,r=state.region;return shell(`<div class="topbar"><div><button class="btn secondary back" onclick="openRegion('${r.id}')">← Volver</button><div class="eyebrow" style="margin-top:18px">${r.label}</div><h1 class="title">${p.title}</h1><div class="meta">${p.desc}</div></div><button class="btn ${state.pro?'secondary':'primary'}" onclick="state.pro=!state.pro;render()">${state.pro?'Modo Premium activo':'Ver Premium'}</button></div>${p.note?`<div class="premium-banner"><b>Nota clínica:</b> ${p.note}</div>`:''}<div class="exlist">${p.ex.map((id,i)=>{let e=EX[id],locked=i>1&&!state.pro;return `<article class="excard" onclick="${locked?'premiumInfo()':`openExercise('${id}')`}"><div class="thumb"><i class="minihead"></i><i class="minibody"></i></div><div><h3>${e.name}</h3><div class="meta">${e.reps} · ${e.level}</div><div class="${locked?'premium':'free'}">${locked?'🔒 PREMIUM':'✓ INCLUIDO GRATIS'}</div></div><div class="lock">${locked?'🔒':'›'}</div></article>`}).join('')}</div>`, 'Ejercicios')}
function premiumInfo(){alert('Este ejercicio pertenece a SpineFlow Premium. En una integración comercial, este botón abrirá el checkout o validará la suscripción del paciente.')}
function openExercise(id){state.ex=EX[id];state.step=0;state.reps=0;state.screen='exercise';render()}
function humanSVG(motion,phase=0){let shift=phase*2;return `<svg viewBox="0 0 760 430" class="motion-${motion}" aria-label="Demostración clínica"><defs><linearGradient id="skin" x1="0" x2="1"><stop stop-color="#efb28b"/><stop offset="1" stop-color="#c87955"/></linearGradient><linearGradient id="shirt" x1="0" x2="1"><stop stop-color="#0b6170"/><stop offset="1" stop-color="#063d4c"/></linearGradient><filter id="ds"><feDropShadow dx="0" dy="10" stdDeviation="12" flood-opacity=".16"/></filter><marker id="arrow" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto"><path d="M0 0L0 8L8 4Z" fill="#2ac39b"/></marker></defs><rect width="760" height="430" fill="#edf4f6"/><ellipse cx="390" cy="350" rx="270" ry="18" fill="#d7e3e7"/><g class="guide" fill="none" stroke="#2ac39b" stroke-width="7" stroke-linecap="round" marker-end="url(#arrow)"><path d="M330 190 Q390 ${145-shift*4} 445 205"/><path d="M405 250 Q455 ${215-shift*3} 510 260" opacity=".65"/></g><g class="person" filter="url(#ds)"><g class="torso"><path d="M305 180Q345 158 414 174Q458 185 478 234Q436 272 351 267Q305 251 285 216Z" fill="url(#shirt)"/><path d="M327 246Q386 279 449 247" fill="#153a46" opacity=".85"/></g><g class="head"><circle cx="275" cy="190" r="43" fill="url(#skin)"/><path d="M240 181Q259 139 306 165Q322 179 314 202Q302 164 248 187Z" fill="#262226"/><circle cx="292" cy="190" r="3.5" fill="#1f2426"/></g><g class="armA"><path d="M326 202L238 282" stroke="url(#skin)" stroke-width="26" stroke-linecap="round"/><circle cx="234" cy="286" r="14" fill="url(#skin)"/></g><g class="armB"><path d="M430 201L516 282" stroke="url(#skin)" stroke-width="26" stroke-linecap="round"/><circle cx="521" cy="286" r="14" fill="url(#skin)"/></g><g class="legs"><g class="legA"><path d="M426 253L526 304L615 345" stroke="#202b35" stroke-width="34" stroke-linecap="round" stroke-linejoin="round"/><path d="M600 345h48" stroke="#111922" stroke-width="23" stroke-linecap="round"/></g><g class="legB"><path d="M390 254L470 326L557 346" stroke="#2b3740" stroke-width="34" stroke-linecap="round" stroke-linejoin="round"/><path d="M543 346h48" stroke="#111922" stroke-width="23" stroke-linecap="round"/></g></g><g class="pelvis"><ellipse cx="421" cy="252" rx="42" ry="26" fill="#173c48" opacity=".82"/></g><path d="M306 202Q356 221 424 248" fill="none" stroke="#f2d164" stroke-width="6" stroke-dasharray="5 7"/></g></svg>`}
function anatomySVG(zone){return `<svg viewBox="0 0 120 150"><circle cx="60" cy="18" r="15" fill="#dfe8eb"/><path d="M42 38Q60 31 78 38L87 94Q78 112 60 112Q42 112 33 94Z" fill="#dfe8eb"/><path d="M39 47L20 91M81 47l19 44M48 109l-6 35M72 109l6 35" stroke="#dfe8eb" stroke-width="13" stroke-linecap="round"/><g fill="#db665e">${/cerv|trapec|cuello|occip|escaleno/i.test(zone)?'<path d="M50 30h20l5 22H45Z"/>':''}${/lumbar|multíf|dorsal|erector/i.test(zone)?'<path d="M43 55h34l5 43H38Z"/>':''}${/abdom|core|transverso|oblicuo/i.test(zone)?'<path d="M43 52h34v45H43Z"/>':''}${/glúte|piriform/i.test(zone)?'<ellipse cx="49" cy="103" rx="15" ry="12"/><ellipse cx="71" cy="103" rx="15" ry="12"/>':''}${/isquio|cuádriceps|pierna|gemelo/i.test(zone)?'<path d="M44 105h14l-4 39H40Z"/><path d="M62 105h14l4 39H66Z"/>':''}</g></svg>`}
function exerciseView(){let e=state.ex,p=state.path,m=(e.muscles||'Core, estabilizadores profundos').split(/,|\(|\)/).map(x=>x.trim()).filter(Boolean).slice(0,4);let phases=['Posición inicial','Movimiento','Mantener','Volver al centro','Repetir'];return shell(`<div class="topbar"><div style="display:flex;gap:16px;align-items:center"><button class="btn primary back" onclick="openPath('${p.id}')">← Volver</button><div><div class="eyebrow">Ejercicio clínico guiado</div><h1 class="title">${e.name}</h1></div></div><span class="pill">${e.level}</span></div><div class="detail"><section><div class="card"><div class="topbar" style="margin:0 0 12px"><b>DEMOSTRACIÓN EN MOVIMIENTO</b><span class="pill">● EN TIEMPO REAL</span></div><div class="stage"><div class="live">MI PROFE · GUÍA VISUAL</div>${humanSVG(e.motion)}<div class="cue">${motionCue[e.motion]||motionCue.standing}</div></div><div class="controls"><button class="btn primary" onclick="togglePlay()">⏯ Pausar / Reanudar</button><button class="btn secondary" onclick="speakGuide()">🔊 Escuchar a Mi profe</button></div><div class="frames">${phases.map((x,i)=>`<div class="frame">${humanSVG(e.motion,i)}<b>${i+1}. ${x}</b></div>`).join('')}</div></div><div class="card" style="margin-top:18px"><b>MÚSCULOS ACTIVADOS</b><div class="anatomy">${m.map(x=>`<div class="muscle">${anatomySVG(x)}<b>${x}</b></div>`).join('')}</div></div></section><aside><div class="card"><div class="topbar" style="margin:0"><div><b>MI PROFE TE GUÍA</b><div class="meta">Escuchá la técnica correcta en español</div></div><button class="btn primary" onclick="speakGuide()">▶ Escuchar</button></div></div><div class="card counter" style="margin-top:16px"><div class="eyebrow">Repeticiones · ${e.reps}</div><div class="big">${state.reps}</div><button class="btn primary" onclick="addRep()">+1 repetición</button></div><div class="card" style="margin-top:16px"><b>PASOS DEL EJERCICIO</b><div class="steps" style="margin-top:12px">${e.steps.map((s,i)=>`<div class="step ${state.step===i?'active':''}" onclick="setStep(${i})"><div class="badge">${i+1}</div><div>${s}</div></div>`).join('')}</div></div><div class="card" style="margin-top:16px"><b>BENEFICIOS Y SEGURIDAD</b><div class="benefits" style="margin-top:12px"><div>Mejora el control y la movilidad</div><div>Activa la musculatura objetivo</div><div>Favorece una técnica progresiva</div></div><div class="warn" style="margin-top:12px"><b>Precaución:</b> ${e.warning}</div></div></aside></div><div class="bottom"><button class="complete" onclick="completeExercise()">Completar y siguiente ejercicio →</button></div>`, 'Ejercicios')}
function setStep(i){state.step=i;render();speak(state.ex.steps[i])}function addRep(){state.reps++;render();beep(660)}function togglePlay(){state.playing=!state.playing;document.body.classList.toggle('paused',!state.playing)}function completeExercise(){beep(820);let ids=state.path.ex,ix=ids.indexOf(state.ex.id),next=ids[ix+1];if(next&&((ix+1)<2||state.pro))openExercise(next);else openPath(state.path.id)}function speakGuide(){let e=state.ex;speak(`${e.name}. ${motionCue[e.motion]||''}. ${e.steps[state.step]}. Respiración: ${e.breathing}`)}function speak(t){speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(t);u.lang='es-AR';u.rate=.92;speechSynthesis.speak(u)}function beep(f=620){let C=window.AudioContext||window.webkitAudioContext,a=new C(),o=a.createOscillator(),g=a.createGain();o.frequency.value=f;o.connect(g);g.connect(a.destination);g.gain.setValueAtTime(.05,a.currentTime);g.gain.exponentialRampToValueAtTime(.001,a.currentTime+.18);o.start();o.stop(a.currentTime+.18)}
function render(){if(state.screen==='landing')$('#app').innerHTML=landing();if(state.screen==='region')$('#app').innerHTML=regionView();if(state.screen==='path')$('#app').innerHTML=pathView();if(state.screen==='exercise')$('#app').innerHTML=exerciseView();document.body.classList.toggle('paused',!state.playing)}
Promise.all([fetch('assets/exercises.json').then(r=>r.json()),fetch('assets/regions.json').then(r=>r.json())]).then(([e,r])=>{EX=e;REG=r;render()}).catch(err=>{$('#app').innerHTML='<div class="boot">No se pudieron cargar los datos. Verificá que la carpeta assets esté subida completa.</div>';console.error(err)});