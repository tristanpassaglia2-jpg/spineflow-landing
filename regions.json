:root{--ink:#102A38;--navy:#063E4D;--navy2:#0B5668;--mint:#27C29A;--sky:#EAF4F7;--line:#D9E7EC;--muted:#6C8290;--white:#fff;--shadow:0 18px 48px rgba(14,55,70,.10)}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,sans-serif;background:#edf5f7;color:var(--ink)}button{font:inherit}.boot{min-height:100vh;display:grid;place-items:center;font-weight:800;color:var(--navy)}.app{min-height:100vh;display:grid;grid-template-columns:245px 1fr}.sidebar{background:linear-gradient(180deg,#063E4D,#084E61);color:white;padding:28px 20px;position:fixed;inset:0 auto 0 0;width:245px;display:flex;flex-direction:column;z-index:10}.brand{font-size:25px;font-weight:800;letter-spacing:.05em}.brandline{font-size:11px;opacity:.75;margin-top:4px}.nav{display:grid;gap:8px;margin-top:38px}.nav button{background:transparent;border:0;color:#dbeef2;text-align:left;padding:13px 14px;border-radius:12px;font-weight:600;cursor:pointer}.nav button:hover,.nav button.active{background:rgba(255,255,255,.12);color:#fff}.coach{margin-top:auto;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:16px;text-align:center}.coachface{width:68px;height:68px;border-radius:50%;margin:0 auto 10px;background:linear-gradient(135deg,#eab18a,#a9603d);position:relative;box-shadow:inset 0 0 0 5px #fff}.coachface:before{content:"";position:absolute;left:11px;right:11px;top:6px;height:25px;background:#252226;border-radius:50% 50% 32% 32%}.coach b{display:block}.coach small{display:block;opacity:.75;margin-top:4px}.content{grid-column:2;padding:28px 34px 42px;max-width:1530px;width:100%;margin:auto}.topbar{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:26px}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:11px;color:var(--muted);font-weight:800}.title{font-size:31px;line-height:1.15;margin:5px 0 0}.pill{display:inline-flex;align-items:center;padding:7px 11px;border-radius:999px;background:#E0F7F0;color:#08765B;font-size:12px;font-weight:800}.btn{border:0;border-radius:12px;padding:12px 16px;font-weight:800;cursor:pointer}.primary{background:var(--navy);color:white;box-shadow:0 8px 22px rgba(6,62,77,.18)}.secondary{background:white;color:var(--navy);border:1px solid var(--line)}.back{font-size:15px;padding:13px 18px;min-width:108px}.hero{background:linear-gradient(135deg,#063E4D,#0D6173);color:white;border-radius:28px;padding:44px;display:grid;grid-template-columns:1.25fr .75fr;gap:30px;box-shadow:var(--shadow);overflow:hidden;position:relative}.hero h1{font-size:43px;max-width:720px;margin:10px 0 16px}.hero p{max-width:650px;line-height:1.65;color:#d5edf1}.herovisual{min-height:270px;position:relative}.spine{position:absolute;left:50%;top:6%;width:54px;height:88%;transform:translateX(-50%);border-radius:40px;background:repeating-linear-gradient(180deg,#fff 0 12px,#8fdccc 12px 18px);filter:drop-shadow(0 0 24px rgba(255,255,255,.25));transform-origin:center;animation:float 4s ease-in-out infinite}.orb{position:absolute;border-radius:50%;filter:blur(2px);background:rgba(64,213,177,.16)}.orb.a{width:220px;height:220px;right:-20px;top:-50px}.orb.b{width:150px;height:150px;left:10px;bottom:-30px}.modules{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:24px}.module{background:white;border:1px solid var(--line);border-radius:20px;padding:24px;cursor:pointer;transition:.2s;box-shadow:0 8px 24px rgba(20,55,70,.05)}.module:hover{transform:translateY(-3px);box-shadow:var(--shadow)}.moduleicon{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;color:white;font-size:22px}.module h3{margin:16px 0 6px}.meta{color:var(--muted);font-size:13px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.pathcard,.excard,.card{background:white;border:1px solid var(--line);border-radius:20px;box-shadow:0 8px 24px rgba(18,55,70,.05)}.pathcard{padding:22px;cursor:pointer}.pathcard:hover{border-color:#9acfd8}.pathhead{display:flex;gap:14px;align-items:center}.pathdot{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;color:white;font-weight:800}.exlist{display:grid;gap:12px}.excard{padding:14px;display:grid;grid-template-columns:94px 1fr auto;gap:14px;align-items:center;cursor:pointer}.thumb{height:68px;border-radius:13px;background:linear-gradient(135deg,#edf5f7,#dbeaed);position:relative;overflow:hidden}.thumb .minihead{position:absolute;width:17px;height:17px;border-radius:50%;background:#e7a47c;left:16px;top:18px}.thumb .minibody{position:absolute;width:45px;height:12px;border-radius:9px;background:#0a5262;left:28px;top:29px;transform:rotate(8deg)}.lock{color:#a8b8c0}.free{color:#078665;font-weight:800;font-size:11px}.premium{color:#9a7a2c;font-weight:800;font-size:11px}.detail{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(370px,.8fr);gap:20px}.card{padding:18px}.stage{background:#eaf2f4;border:1px solid #cfe0e5;border-radius:18px;overflow:hidden;position:relative;aspect-ratio:16/9}.stage svg{width:100%;height:100%;display:block}.live{position:absolute;z-index:3;left:16px;top:16px;background:white;border-radius:999px;padding:8px 12px;font-size:11px;font-weight:800;box-shadow:0 5px 18px rgba(0,0,0,.1)}.cue{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);background:rgba(5,49,61,.84);color:white;padding:10px 18px;border-radius:999px;font-size:12px;white-space:nowrap}.controls{display:flex;gap:10px;margin-top:12px}.frames{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:12px}.frame{background:#eef5f7;border:1px solid var(--line);border-radius:12px;padding:7px;text-align:center;font-size:10px;color:var(--muted)}.frame svg{width:100%;height:70px}.anatomy{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}.muscle{background:#f8fbfc;border:1px solid var(--line);border-radius:13px;padding:8px;text-align:center;font-size:10px}.muscle svg{height:85px;width:100%}.steps{display:grid;gap:8px}.step{display:grid;grid-template-columns:30px 1fr;gap:10px;padding:13px;border:1px solid #e4ecef;border-radius:13px;background:#fbfdfe;font-size:12px;line-height:1.45;cursor:pointer}.step.active{border-color:#2fc49e;background:#f1fcf8}.badge{width:25px;height:25px;border-radius:50%;display:grid;place-items:center;background:#dde8ec;font-weight:800}.step.active .badge{background:#20b88e;color:white}.counter{text-align:center}.big{font-size:44px;font-weight:800;color:#0b9574;margin:8px}.warn{background:#fff7e7;border:1px solid #f0d59a;padding:13px;border-radius:12px;font-size:12px;line-height:1.5}.benefits{display:grid;gap:8px;font-size:13px}.benefits div:before{content:'✓';color:#16a77f;font-weight:800;margin-right:8px}.bottom{position:sticky;bottom:10px;margin-top:18px}.complete{width:100%;padding:16px;border:0;border-radius:14px;background:var(--navy);color:white;font-weight:800;font-size:15px;box-shadow:0 12px 30px rgba(6,62,77,.24)}.premium-banner{background:linear-gradient(135deg,#fff7db,#fff);border:1px solid #ead899;padding:18px;border-radius:16px;margin-bottom:16px}.paused .person{animation-play-state:paused!important}.person{transform-origin:center;animation:move 3.4s ease-in-out infinite}.motion-neckside .head{transform-origin:280px 205px;animation:neckside 3s ease-in-out infinite}.motion-neckrotate .head{transform-origin:280px 205px;animation:neckrot 3s ease-in-out infinite}.motion-chin .head{animation:chin 3s ease-in-out infinite}.motion-bridge .pelvis{animation:bridge 3s ease-in-out infinite}.motion-kneechest .legA{animation:knee 3s ease-in-out infinite}.motion-catcow .torso{animation:catcow 3s ease-in-out infinite}.motion-lumbarrotate .legs{transform-origin:450px 320px;animation:rotatelegs 3s ease-in-out infinite}.motion-birddog .armA,.motion-birddog .legB{animation:extend 3s ease-in-out infinite}.motion-deadbug .armA,.motion-deadbug .legB{animation:extend 3s ease-in-out infinite}.motion-squat .person{animation:squat 3s ease-in-out infinite}.motion-march .legA{animation:march 2.5s ease-in-out infinite}@keyframes float{50%{transform:translateX(-50%) translateY(-10px)}}@keyframes move{50%{transform:translateY(-3px)}}@keyframes neckside{50%{transform:rotate(16deg)}}@keyframes neckrot{50%{transform:scaleX(.84)}}@keyframes chin{50%{transform:translateX(-10px)}}@keyframes bridge{50%{transform:translateY(-35px) rotate(-8deg)}}@keyframes knee{50%{transform:rotate(-36deg) translate(-20px,-5px)}}@keyframes catcow{50%{transform:skewY(-8deg) translateY(-10px)}}@keyframes rotatelegs{50%{transform:rotate(15deg)}}@keyframes extend{50%{transform:rotate(-22deg) translate(15px,-10px)}}@keyframes squat{50%{transform:translateY(40px)}}@keyframes march{50%{transform:rotate(-35deg)}}@media(max-width:980px){.app{display:block}.sidebar{position:static;width:auto;height:auto;flex-direction:row;align-items:center;padding:14px 18px}.brandline,.nav,.coach{display:none}.content{padding:18px}.hero{grid-template-columns:1fr}.herovisual{display:none}.modules,.grid{grid-template-columns:1fr}.detail{grid-template-columns:1fr}.title{font-size:24px}.frames{grid-template-columns:repeat(5,140px);overflow:auto}.anatomy{grid-template-columns:repeat(2,1fr)}}