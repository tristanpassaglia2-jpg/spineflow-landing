{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/assets/images/valen.png",
      "destination": "/media/coach/mi-profe.webp",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
